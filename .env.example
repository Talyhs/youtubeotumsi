# Copy this file to .env locally and fill only the credentials you use.
# Never commit .env, token.json, client_secrets.json, or API keys.
GEMINI_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# For local YouTube upload. Prefer token.json ignored by Git when possible.
TOKEN_JSON=
# Optional: default local engine uses Edge TTS.
VOICE_PROVIDER=edge
# Optional Ollama endpoint/model are entered in the Windows app.
OLLAMA_BASE_URL=http://127.0.0.1:11434
